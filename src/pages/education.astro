---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Timeline from '../components/Timeline.astro';
import site from '../data/site.json';
import education from '../data/education.json';

const num = (key: string) => site.sectionOrder.indexOf(key) + 1;
---
<Base title={site.pages.education.title} description={site.pages.education.description} active="education">
    <section class="section" id="education">
        <SectionHead number={num('education')} {...site.sections.education} />
        <Timeline items={education} />
    </section>
</Base>
