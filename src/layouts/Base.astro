---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active?: string;      // nav key of the current page, e.g. "about"
  mainClass?: string;
  showFooterCta?: boolean;
}
const { title, description, active, mainClass = 'page-main', showFooterCta = true } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/styles.css">
    <script is:inline src="/theme-init.js"></script>
    <slot name="head" />
</head>
<body id="top">
    <div class="scroll-progress" id="scrollProgress"></div>
    <div class="cursor-glow" id="cursorGlow"></div>

    <div class="bg-fx" aria-hidden="true">
        <div class="aurora a1"></div>
        <div class="aurora a2"></div>
        <div class="aurora a3"></div>
        <div class="grid-overlay"></div>
    </div>

    <Navbar active={active} />

    <main class={mainClass}>
        <slot />
    </main>

    <Footer showCta={showFooterCta} />

    <script is:inline src="/script.js"></script>
</body>
</html>
